# Default deny: publication uses an explicit source allowlist.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/scripts/
!/launcher/
!/host/
!/sdk/
!/build-game.cmd
!/activate-tools.cmd
!/CMakeLists.txt
!/patches/

# The game host: source and recompiler metadata only.
/host/*
!/host/CMakeLists.txt
!/host/launcher_icon.rc.in
!/host/README.md
!/host/.gitignore
!/host/config/
!/host/src/
/host/generated/
/host/assets/
/host/ui/
/host/run/

# Launcher source and supplied icon; never user preferences or backups.
/launcher/*
!/launcher/src/
!/launcher/assets/
!/launcher/build.cmd
!/launcher/README.md
/launcher/assets/*
!/launcher/assets/launcher.ico
!/launcher/assets/launcher.png

# Local or derived files, regardless of depth.
**/.git/
**/.vs/
**/.vscode/
**/__pycache__/
**/build/
**/out/
**/logs/
**/hdd/
**/CrashDumps/
**/dump-path.txt
**/settings.toml
*.exe
*.dll
*.pdb
*.obj
*.o
*.zip
*.7z
*.iso
*.cso
*.xbe
*.lmp
*.bgra
*.dmp
*.log
*.tmp
*.pyc
*.source.json
